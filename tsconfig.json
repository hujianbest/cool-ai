    ".next-thread-smoke-13324/dev/types/**/*.ts",
    ".next-thread-smoke-14088/types/**/*.ts",
    ".next-thread-smoke-14088/dev/types/**/*.ts",
    ".next-thread-smoke-12444/types/**/*.ts",
    ".next-thread-smoke-12444/dev/types/**/*.ts",
    ".next-attach-repro-17280/types/**/*.ts",
    ".next-attach-repro-17280/dev/types/**/*.ts",
