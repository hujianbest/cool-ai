  gap: var(--space-2);
}

.form-field {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: var(--space-1);
}

.project-list button,
.project-list a {
  display: block;
  min-height: var(--control-min);
  border-radius: var(--radius-sm);
  padding: var(--space-2) var(--space-3);
  text-align: start;
}

.project-list button[aria-current=\"page\"],
.project-list a[aria-current=\"page\"] {
  background: var(--accent);
  color: var(--surface);
}

.composer,
.decision-panel,
.run-detail,
.timeline,
.task-summary,
.context-body,
.state-message {
  border-radius: var(--radius-md);
  padding: var(--space-4);
  background: var(--surface);
  box-shadow: var(--shadow-panel);
}

.composer,
.decision-panel,
.mention-picker,
.mention-options,
.mention-options [role=\"listbox\"] {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.run-details {
  display: flex;
  flex-wrap: wrap;
  align-items: stretch;
  gap: var(--space-3);
}

.run-details > * {
  flex: 1;
}

.run-details > .state-message {
  flex-basis: 100%;
}

.execution-card {
  min-width: 0;
}

.execution-progress-list,
.execution-progress {
  display: grid;
  gap: var(--space-2);
}

.execution-progress progress {
  width: var(--full-width);
  accent-color: var(--accent);
}

.execution-card-controls {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.execution-card-controls button {
  min-height: var(--control-min);
}

.execution-review {
  min-width: 0;
  border-block: var(--border-width) solid var(--border);
  padding-block: var(--space-3);
}

.execution-review-tabs,
.execution-review-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.execution-review-tabs {
  border-bottom: var(--border-width) solid var(--border);
}

.execution-review-tabs button,
.execution-review-actions button,
.execution-review button {
  min-height: var(--control-min);
}

.execution-review-tabs [aria-selected=\"true\"] {
  background: var(--surface-muted);
  box-shadow: var(--focus-ring);
}

.execution-approval,
.execution-staged-summary,
.execution-review-item {
  border: var(--border-width) solid var(--border);
  border-radius: var(--radius-sm);
  padding: var(--space-3);
  background: var(--surface-muted);
}

.execution-approval {
  border-color: var(--warning);
}

.execution-review-facts {
  display: grid;
  gap: var(--space-2);
  margin: 0;
}

.execution-review-facts div {
  display: grid;
  grid-template-columns: var(--execution-review-facts-columns);
  gap: var(--space-2);
}

.execution-review-facts dt {
  color: var(--text-muted);
}

.execution-review-facts dd {
  min-width: 0;
  margin: 0;
}

.execution-review-code {
  max-height: calc(var(--control-min) * 8);
  overflow: auto;
  margin: 0;
  border-radius: var(--radius-sm);
  padding: var(--space-3);
  background: var(--surface);
  font-family: var(--font-mono);
  white-space: pre-wrap;
