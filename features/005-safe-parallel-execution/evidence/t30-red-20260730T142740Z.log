}

.collaboration-mobile-surface .stack,
.collaboration-mobile-surface .run-details {
  min-width: 0;
}

.collaboration-mobile-surface .run-details {
  display: grid;
  grid-template-columns: var(--single-column);
}

.collaboration-mobile-surface .run-detail,
.collaboration-mobile-surface .metric-grid,
.collaboration-mobile-surface .usage-agents li {
  min-width: 0;
  overflow-wrap: anywhere;
}

.run-detail,
.usage-agents {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.control-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.metric-grid {
